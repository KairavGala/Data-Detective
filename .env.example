# =============================================================================
# Server-side only environment variables (Vercel Serverless Functions /api/*)
# NEVER prefix secrets with VITE_ or expose them in frontend browser bundles.
# =============================================================================

# Required for live Gemini API calls (server-side only).
GEMINI_API_KEY=""

# Optional centralized Gemini model ID (default: gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# Optional conservative prototype timeout budgets in milliseconds.
# Must satisfy: GEMINI_TIMEOUT_MS < API_HANDLER_TIMEOUT_MS <= 28000 (Vercel cap: 30s).
GEMINI_TIMEOUT_MS="18000"
API_HANDLER_TIMEOUT_MS="22000"

# Optional toggle for /api/ai/prototype.
# Defaults to enabled in local dev / Vercel Preview, disabled in Vercel Production.
AI_PROTOTYPE_ENABLED=""

# Deployed origin URL used for server-side links or callbacks.
APP_URL=""
